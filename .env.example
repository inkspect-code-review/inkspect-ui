# Use your own instance values. This is not a working credential file.
BETTER_AUTH_URL=https://inkspect.example.com
# Generate a fresh random secret of at least 32 characters.
BETTER_AUTH_SECRET=
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/inkspect
INKSPECT_API_ORIGIN=http://127.0.0.1:3003
INKSPECT_ENGINE_URL=http://127.0.0.1:8091
# Use a different fresh secret for service authentication.
INKSPECT_ENGINE_SECRET=
INKSPECT_GENERATION=instance-v1
INKSPECT_RUST_BINARY=/absolute/path/to/inkspect-engine
INKSPECT_RUST_HOST_CONFIG=/absolute/private/path/host.json
INKSPECT_RUST_STATE=/absolute/private/path/engine-state

# OAuth sign-in. Additional optional prefixes: GOOGLE, MICROSOFT, APPLE.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Repository App configuration can be separate from sign-in OAuth.
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=/absolute/private/path/github-app.pem
API_GITHUB_WEBHOOK_SECRET_FILE=/absolute/private/path/github-webhook-secret

# SMTP is one supported magic-link delivery option; requires TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Instance model credentials. Prefer the runtime's scoped identity where supported.
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
INKSPECT_DEFAULT_CHAT_MODEL=
# Optional explicit chat pricing; match the selected model and region.
INKSPECT_AI_PRICING_MODEL=
INKSPECT_AI_PRICING_REGION=
INKSPECT_AI_INPUT_NANO_USD=
INKSPECT_AI_OUTPUT_NANO_USD=
INKSPECT_QDRANT_URL=http://127.0.0.1:6333
INKSPECT_QDRANT_API_KEY=

# Optional organization keys: public key in API, private key in engine only.
INKSPECT_BYOK_PUBLIC_KEY_FILE=
INKSPECT_BYOK_PRIVATE_KEY_FILE=
# Optional realtime service. Leave blank to use polling.
PUBB_APP_ID=
PUBB_APP_SECRET=
NEXT_PUBLIC_PUBB_APP_KEY=
# Optional workspace logos and instance policy links.
INKSPECT_ASSETS_BUCKET=
INKSPECT_TERMS_URL=
INKSPECT_PRIVACY_URL=

# Instance-wide provider for reviews, fixes, chat and retrieval.
INKSPECT_AI_PROVIDER=bedrock
INKSPECT_API_KEY=
